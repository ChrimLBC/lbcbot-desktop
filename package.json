{
  "name": "lbcbot-desktop",
  "version": "1.0.7",
  "description": "LBCBot desktop app — bridges OBS to LBCBot in both directions and sets up overlay browser sources.",
  "private": true,
  "author": {
    "name": "LBCBot",
    "email": "chrisleblanc1432@gmail.com"
  },
  "homepage": "https://lbcbot.devsoperative.com",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "electron-updater": "^6.3.9",
    "obs-websocket-js": "^5.0.8",
    "sockjs-client": "^1.6.1"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lbcbot.desktop",
    "productName": "LBCBot",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ChrimLBC",
        "repo": "lbcbot-desktop"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "LBCBot-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LBCBot"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
